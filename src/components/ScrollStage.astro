---
interface Props {
  videoSrc?: string;
  posterSrc?: string;
}

const {
  videoSrc = '/media/video.mp4',
  posterSrc = '/media/poster.jpg',
} = Astro.props;
---

<video
  id="scrollVideo"
  class="scroll-video"
  src={videoSrc}
  poster={posterSrc}
  muted
  playsinline
  preload="auto"
  aria-hidden="true"
  tabindex="-1"
>
</video>

<div
  class="scroll-fallback"
  style={`background-image: url("${posterSrc}");`}
  aria-hidden="true"
>
</div>

<div class="scroll-overlay">
  <slot />
</div>

<div
  id="loader"
  class="loader"
  role="status"
  aria-live="polite"
  aria-label="Loading Maravilla"
>
  <span class="loader__mark" aria-hidden="true">Maravilla</span>
  <span class="loader__track" aria-hidden="true">
    <span class="loader__bar"></span>
  </span>
</div>
