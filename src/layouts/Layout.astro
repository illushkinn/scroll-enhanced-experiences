---
import '../styles/tokens.css';
import '../styles/global.css';
import { content, locales, defaultLocale, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
  image?: string;
}

const { locale, image = '/media/og.jpg' } = Astro.props;
const t = content[locale];

const siteURL = Astro.site ?? new URL('https://libertad-buildings.example.com');
const canonicalURL = new URL(t.path, siteURL);
const imageURL = new URL(image, siteURL);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonicalURL} />
    {
      locales.map((l) => (
        <link
          rel="alternate"
          hreflang={content[l].htmlLang}
          href={new URL(content[l].path, siteURL)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(content[defaultLocale].path, siteURL)}
    />
    <meta name="theme-color" content="#0d0f1a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.brand} />
    <meta property="og:locale" content={t.ogLocale} />
    {
      locales
        .filter((l) => l !== locale)
        .map((l) => (
          <meta property="og:locale:alternate" content={content[l].ogLocale} />
        ))
    }
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={imageURL} />
    <!-- The hero still is injected by the engine, so the browser would only find it
         after the module runs. Preload it with the same phone/desktop split as the
         engine's isMobile() (coarse pointer or ≤860px). -->
    <link
      rel="preload"
      as="image"
      href="/media/stops/s0-m.webp"
      media="(max-width: 860px), (hover: none) and (pointer: coarse)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/media/stops/s0.webp"
      media="(min-width: 861px) and (hover: hover), (min-width: 861px) and (pointer: fine), (min-width: 861px) and (pointer: none)"
      fetchpriority="high"
    />
    <!-- Lets CSS hide the static (no-JS) story before the first paint. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // If the engine module never runs (blocked, failed to load, 404 after a
      // redeploy), show the static story instead of a blank page. Module scripts
      // run before DOMContentLoaded, so a mounted engine is already in place here.
      addEventListener('DOMContentLoaded', function () {
        if (!document.querySelector('#world .sw-stage')) {
          document.documentElement.classList.remove('js');
        }
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
